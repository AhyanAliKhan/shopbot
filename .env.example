# ---- Agent API (agent/.env locally, or Space/Render secrets in production) ----
ANTHROPIC_API_KEY=sk-ant-your-group-key-here
MODEL=claude-haiku-5-5
EFFORT=low
MAX_TOKENS=800

# Neon or Supabase Postgres. Leave empty to use a local SQLite file (dev only).
# Neon:     postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Supabase: postgresql://postgres.xxxx:pass@aws-0-region.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Protects /admin/* (the dashboard asks for this key)
ADMIN_API_KEY=pick-a-long-random-admin-key
# Signs storefront session tokens
SESSION_SECRET=pick-another-long-random-string
STORE_NAME=Bazaar Bloom
